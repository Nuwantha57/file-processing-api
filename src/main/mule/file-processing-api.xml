<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd">

    <!-- HTTP Listener Configuration -->
    <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
        <http:listener-connection host="0.0.0.0" port="8081"/>
    </http:listener-config>

    <!-- Database Configuration -->
    <db:config name="Database_Config" doc:name="Database Config">
        <db:generic-connection url="jdbc:postgresql://localhost:5432/employee_management"
                               driverClassName="org.postgresql.Driver"
                               user="postgres"
                               password="nuwantha123@"/>
    </db:config>

    <!-- Main Flow for Multiple CSV and Excel Files -->
    <flow name="upload-multiple-files-flow" doc:name="Upload Multiple Files Flow">
        <!-- HTTP Listener -->
        <http:listener doc:name="Listener" config-ref="HTTP_Listener_config" path="/upload-files" allowedMethods="POST"/>

        <!-- Extract all files from multipart -->
        <ee:transform doc:name="Extract Files">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
input payload multipart/form-data
output application/java
---
payload.parts pluck (value, key) -> {
    partName: key,
    fileContent: value.content,
    contentType: value.headers.'Content-Type' default "",
    fileName: value.headers.'Content-Disposition'.filename default ""
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <ee:transform doc:name="Initialize Variables">
            <ee:message>
            </ee:message>
            <ee:variables>
                <ee:set-variable variableName="totalRecords"><![CDATA[0]]></ee:set-variable>
                <ee:set-variable variableName="fileResults"><![CDATA[%dw 2.0
output application/json
---
[]]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <!-- Process each file -->
        <foreach doc:name="For Each File" collection="#[payload]">
            <logger level="INFO" doc:name="Log Processing" message="#['Processing file: ' ++ payload.fileName]"/>
            
            <choice doc:name="Is File Upload?">
                <when expression="#[payload.fileName != '']">
                    <try doc:name="Try Process File">
                        <!-- Parse individual file -->
                        <ee:transform doc:name="Parse File Content">
                            <ee:message>
                                <ee:set-payload><![CDATA[%dw 2.0
output application/json
import * from dw::core::Strings
---
do {
    var fileName = lower(payload.fileName default "")
    var fileContent = payload.fileContent
    var contentType = lower(payload.contentType default "")
    var isExcel = (fileName contains ".xlsx") or (fileName contains ".xls") or (contentType contains "spreadsheet") or (contentType contains "excel")
    var isCsv = (fileName contains ".csv") or (contentType contains "csv")
    ---
    {
        fileName: payload.fileName,
        partName: payload.partName,
        fileType: if (isExcel) "EXCEL" else if (isCsv) "CSV" else "UNKNOWN",
        records: (
            if (isExcel)
                do {
                    var allSheets = fileContent
                    var sheetNames = namesOf(allSheets)
                    var firstSheetName = sheetNames[0]
                    var firstSheet = allSheets[firstSheetName]
                    ---
                    if (isEmpty(firstSheet))
                        []
                    else
                        firstSheet map (row) -> {
                            source_id: row.id as Number,
                            name: row.name default "UNKNOWN",
                            email: row.email default "noemail@example.com",
                            age: row.age as Number default 0
                        }
                }
            else if (isCsv)
                do {
                    var csvContent = fileContent
                    ---
                    if (isEmpty(csvContent))
                        []
                    else
                        csvContent map (row) -> {
                            source_id: row.id as Number,
                            name: row.name default "UNKNOWN",
                            email: row.email default "noemail@example.com",
                            age: row.age as Number default 0
                        }
                }
            else
                []
        )
    }
}
]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>

                        <!-- Store file metadata -->
                        <set-variable value="#[payload.fileName]" doc:name="Store File Name" variableName="currentFileName"/>
                        <set-variable value="#[payload.records]" doc:name="Store Records" variableName="currentRecords"/>
                        <set-variable value="#[payload.fileType]" doc:name="Store File Type" variableName="currentFileType"/>

                        <!-- Check if valid file and has records -->
                        <choice doc:name="Check File Validity">
                            <when expression="#[vars.currentFileType == 'UNKNOWN']">
                                <ee:transform doc:name="Add Unsupported File Error">
                                    <ee:message>
                                    </ee:message>
                                    <ee:variables>
                                        <ee:set-variable variableName="fileResults"><![CDATA[%dw 2.0
output application/json
---
vars.fileResults + [{fileName: vars.currentFileName, status: 'ERROR', message: 'Unsupported file type. Only CSV and Excel files are supported.'}]]]></ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </when>
                            <when expression="#[sizeOf(vars.currentRecords) == 0]">
                                <ee:transform doc:name="Add Empty File Error">
                                    <ee:message>
                                    </ee:message>
                                    <ee:variables>
                                        <ee:set-variable variableName="fileResults"><![CDATA[%dw 2.0
output application/json
---
vars.fileResults + [{fileName: vars.currentFileName, status: 'ERROR', message: 'File is empty or has no valid data.'}]]]></ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </when>
                            <otherwise>
                                <!-- Insert records into database -->
                                <set-variable value="#[0]" doc:name="Initialize Inserted Count" variableName="insertedCount"/>
                                
                                <foreach doc:name="For Each Record" collection="#[vars.currentRecords]">
                                    <try doc:name="Try Insert">
                                        <db:insert doc:name="Insert Record" config-ref="Database_Config">
                                            <db:sql><![CDATA[INSERT INTO records (source_id, name, email, age) VALUES (:source_id, :name, :email, :age) ON CONFLICT (source_id) DO NOTHING]]></db:sql>
                                            <db:input-parameters><![CDATA[#[payload]]]></db:input-parameters>
                                        </db:insert>
                                        
                                        <set-variable value="#[vars.insertedCount + 1]" doc:name="Increment Count" variableName="insertedCount"/>
                                        
                                        <error-handler>
                                            <on-error-continue enableNotifications="true" logException="true">
                                                <logger level="WARN" doc:name="Log Insert Error" message="#['Failed to insert record: ' ++ error.description]"/>
                                            </on-error-continue>
                                        </error-handler>
                                    </try>
                                </foreach>

                                <!-- Update totals and add success result -->
                                <set-variable value="#[vars.totalRecords + vars.insertedCount]" doc:name="Update Total" variableName="totalRecords"/>
                                <ee:transform doc:name="Add Success Result">
                                    <ee:message>
                                    </ee:message>
                                    <ee:variables>
                                        <ee:set-variable variableName="fileResults"><![CDATA[%dw 2.0
output application/json
---
vars.fileResults + [{fileName: vars.currentFileName, status: 'SUCCESS', recordsProcessed: sizeOf(vars.currentRecords), recordsInserted: vars.insertedCount}]]]></ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </otherwise>
                        </choice>

                        <!-- Error handler for file processing -->
                        <error-handler>
                            <on-error-continue enableNotifications="true" logException="true">
                                <logger level="ERROR" doc:name="Log Processing Error" message="#['Error processing file: ' ++ error.description]"/>
                                <ee:transform doc:name="Add Processing Error">
                                    <ee:message>
                                    </ee:message>
                                    <ee:variables>
                                        <ee:set-variable variableName="fileResults"><![CDATA[%dw 2.0
output application/json
---
vars.fileResults + [{fileName: (vars.currentFileName default 'unknown'), status: 'ERROR', message: error.description}]]]></ee:set-variable>
                                    </ee:variables>
                                </ee:transform>
                            </on-error-continue>
                        </error-handler>
                    </try>
                </when>
                <otherwise>
                    <logger level="DEBUG" doc:name="Skip Non-File Part" message="#['Skipping non-file part: ' ++ payload.partName]"/>
                </otherwise>
            </choice>
        </foreach>

        <!-- Build final response -->
        <ee:transform doc:name="Build Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "COMPLETED",
    message: "Multiple file upload processed",
    totalFilesProcessed: sizeOf(vars.fileResults),
    totalRecordsInserted: vars.totalRecords,
    results: vars.fileResults
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <!-- Global error handler -->
        <error-handler>
            <on-error-continue enableNotifications="true" logException="true">
                <logger level="ERROR" doc:name="Log Global Error" message="#['Global error occurred: ' ++ error.description]"/>
                <ee:transform doc:name="Error Response">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "ERROR",
    message: "An error occurred during file upload processing",
    error: error.description
}
]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>
</mule>